# FlightFinder MCP HTTP Server Dockerfile
# Multi-stage build: Node.js for UI, Python for server
#
# Deploy: railway up / fly deploy --config fly.mcp.toml --dockerfile Dockerfile.mcp

# Stage 1: Build UI bundles
FROM node:20-slim AS ui-builder
WORKDIR /ui
COPY ui/package.json ui/package-lock.json ./
RUN npm ci
COPY ui/ ./
RUN npm run build:all

# Stage 2: Python server
FROM python:3.11-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    && rm -rf /var/lib/apt/lists/*

# Copy project files (README.md required by pyproject.toml)
COPY pyproject.toml README.md ./
COPY src/ src/

# Install the package with MCP HTTP dependencies
RUN pip install --no-cache-dir -e ".[mcp-http]"

# Copy built UI bundles from stage 1
COPY --from=ui-builder /ui/dist/ /app/ui/dist/

# Set environment variables
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1

# Expose the HTTP port
EXPOSE 3001

# Run the MCP HTTP server
CMD ["python", "-m", "flightfinder.mcp_http_server", "--port", "3001"]
