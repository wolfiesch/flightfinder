# FlightFinder MCP HTTP Server Dockerfile
# For deployment on Fly.io - serves MCP Apps UI for Claude Desktop/Web
#
# Build: fly deploy --config fly.mcp.toml --dockerfile Dockerfile.mcp

FROM python:3.11-slim

# Set working directory
WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    && rm -rf /var/lib/apt/lists/*

# Copy project files (README.md required by pyproject.toml)
COPY pyproject.toml README.md ./
COPY src/ src/

# Install the package with MCP HTTP dependencies
RUN pip install --no-cache-dir -e ".[mcp-http]"

# Copy pre-built UI bundles (5 views: flights, roundtrip, hotels, locations, trip)
COPY ui/dist/ /app/ui/dist/

# Set environment variables
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1

# Expose the HTTP port
EXPOSE 3001

# Run the MCP HTTP server
CMD ["python", "-m", "flightfinder.mcp_http_server", "--port", "3001"]
